// Code 2
const int ledPin = 5;
const int NosePin = 14;
const int bpm = 167;
const int beatTime = 60000 / bpm;
const int stepTime = beatTime / 50;
void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(NosePin, OUTPUT);
  digitalWrite(NosePin, HIGH);
}
void loop() {
  for (int i = 0; i <= 100; i += 2) {
    analogWrite(ledPin, i);
    delay(stepTime);
  }
  analogWrite(ledPin, 0);
}
