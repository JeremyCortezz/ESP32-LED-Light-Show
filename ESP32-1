void loop() {
 // put your main code here, to run repeatedly:
   // Iteration the button is only active when the button is held
 if (digitalRead(Button) == 0) {
   // For loop increasing the brightness from 1 to 100 for Chain1 LEDS
   for (int i = 0; i < 120; i++){
     analogWrite(LEDChain1, i);
     analogWrite(LEDChain2, 0);
     delay(1);
   }
   delay(80);
   analogWrite(LEDChain1, 0);
  
   // 2nd For loop doing the same thing but for Chain2 LEDS
   for (int i = 0; i < 120; i++){
     analogWrite(LEDChain2, i);
     analogWrite(LEDChain1, 0);
     delay(1);
   }
     delay(80);
     analogWrite(LEDChain2, 0);
 }
}




